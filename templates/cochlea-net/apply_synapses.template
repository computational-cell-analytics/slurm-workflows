#!/bin/bash
#SBATCH --job-name=apply-synapses_<cochlea_job_name>
#SBATCH -t <time>
#SBATCH --mail-user=<user_address>
#SBATCH --mail-type=FAIL

#SBATCH -p grete:shared
#SBATCH -A <account_name>
#SBATCH -G A100:1
# The prefetch workers load the next blocks while the GPU predicts, so give the job cores.
#SBATCH -c 8
#SBATCH --mem <mem>
#SBATCH -a 0-<last_instance>

# Print the exit code for the archive, see doc/new_template.md.
trap 'exit 143' TERM
trap 'echo "Exit code of the job: $?"' EXIT

source ~/.bashrc
micromamba activate <cochlea-net_environment>

echo "Current node: ${SLURM_NODELIST}"

export INPUT=<data_dir>/<cochlea>/<cochlea_data>
export OUTPUT_FOLDER=<data_dir>/predictions/<cochlea>/<prediction_dir>
export INPUT_KEY=<input_key>
export MODEL=<model>
export PREDICTION_INSTANCES=<instances>

echo "Input directory: ${INPUT}"
echo "Output directory: ${OUTPUT_FOLDER}"
echo "Model: ${MODEL}"

# Verify the input of the job. A missing input stops the rest of the pipeline.
# The mask of 'mask_synapses' is read by the prediction itself, not passed to it.
for path in "$INPUT" "$OUTPUT_FOLDER"/mask.zarr ; do
	if [ ! -e "$path" ] ; then
		echo "Missing input of the job: $path"
		exit 1
	fi
done

flamingo_tools.run_synapse_prediction_slurm --input_path "$INPUT" --input_key "$INPUT_KEY" \
	--output_folder "$OUTPUT_FOLDER" --model_path "$MODEL" --prediction_instances "$PREDICTION_INSTANCES"
