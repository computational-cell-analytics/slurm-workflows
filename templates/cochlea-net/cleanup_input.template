#!/bin/bash
#SBATCH --job-name=<job_name>
#SBATCH -t <time>
#SBATCH --mail-user=<user_address>
#SBATCH --mail-type=FAIL

#SBATCH -p standard96s:shared
#SBATCH -A <account_name>
#SBATCH -c 1
#SBATCH --mem <mem>
#SBATCH --constraint=inet

# Print the exit code for the archive, see doc/new_template.md.
trap 'exit 143' TERM
trap 'echo "Exit code of the job: $?"' EXIT

source ~/.bashrc

# Remove the image data of the stain which the pipeline read, e.g. the OME-Zarr of '--download'.
# An n5 can hold the stains of other pipelines, so only the setup of the stain is removed. The n5
# is removed with its last setup.
INPUT=<data_dir>/<cochlea>/<cochlea_data>
INPUT_KEY=<input_key>

# The input is removed only if the S3 bucket holds the stain, so that '--download' can restore it.
S3_REMOTE=<s3_remote>
STAIN=<stain>

# Verify the input of the job. A missing input stops the rest of the pipeline.
for path in "$INPUT" ; do
	if [ ! -e "$path" ] ; then
		echo "Missing input of the job: $path"
		exit 1
	fi
done

module load rclone

# The transfer lists a source in the dataset.json of the bucket only after its data is complete, so
# a data folder alone can be a partial copy. The source must list image data, which 'download_image'
# can restore. Its OME-Zarr folder can have another name, see 'download_image'. A failed 'rclone cat'
# gives no valid JSON, so the input is kept.
IMAGE_PATH=$(rclone cat "$S3_REMOTE/<cochlea>/dataset.json" | python3 -c '
import json, sys
entry = json.load(sys.stdin)["sources"].get(sys.argv[1], {})
image_data = next(iter(entry.values()), {}).get("imageData", {})
if "ome.zarr.s3" in image_data:
    print(image_data["ome.zarr.s3"]["s3Address"].split("/" + sys.argv[2] + "/", 1)[-1].rstrip("/"))
elif "ome.zarr" in image_data:
    print(image_data["ome.zarr"]["relativePath"].rstrip("/"))
' "$STAIN" "<cochlea>")
if [ -z "$IMAGE_PATH" ] ; then
	echo "The dataset.json of $S3_REMOTE/<cochlea> lists no image data of a source $STAIN. The input is kept."
	exit 1
fi

# The file system removes one file per round trip, so its latency limits a single 'rm -rf' to a few
# hundred files per second. Parallel processes remove the files, then 'rm -rf' removes the folders.
REMOVE_PROCESSES=8

remove_tree() {
	local start=$SECONDS
	if [ ! -e "$1" ] ; then
		return 0
	fi
	find "$1" -type f -print0 | xargs -0 -r -P "$REMOVE_PROCESSES" -n 1000 rm -f || return 1
	rm -rf "$1" || return 1
	echo "Removed $1 in $((SECONDS - start)) s"
}

# A path is renamed before its removal, so that an interrupted job leaves no partial input, which a
# later deployment would read.
remove() {
	local trash
	trash="$(dirname "$1")/removing_$(basename "$1")"
	echo "Removing $1"
	if [ -e "$1" ] ; then
		# A job which stopped early, e.g. at its time limit, can leave the trash, and 'mv -T' cannot
		# replace a folder which is not empty.
		remove_tree "$trash" || exit 1
		mv -T "$1" "$trash" || exit 1
	fi
	remove_tree "$trash" || exit 1
}

# The input key of an n5 starts with the setup folder of the stain, e.g. 'setup0/timepoint0/s0'.
if [[ "$INPUT" == *.n5 ]] ; then
	remove "$INPUT/${INPUT_KEY%%/*}"
	if compgen -G "$INPUT/setup*" > /dev/null ; then
		exit 0
	fi
fi

remove "$INPUT"
