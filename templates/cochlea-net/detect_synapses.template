#!/bin/bash
#SBATCH --job-name=detect-synapses_<cochlea_job_name>
#SBATCH -t <time>
#SBATCH --mail-user=<user_address>
#SBATCH --mail-type=FAIL

#SBATCH -p standard96s:shared
#SBATCH -A <account_name>
# The peak detection is thread-parallel over blocks, so it scales with the cores.
#SBATCH -c 16
#SBATCH --mem <mem>
#SBATCH --constraint=inet       # the IHC segmentation is read from the S3 bucket

source ~/.bashrc
micromamba activate <cochlea-net_environment>

echo "Current node: ${SLURM_NODELIST}"

export OUTPUT_FOLDER=<data_dir>/predictions/<cochlea>/<prediction_dir>

# IHC segmentation on the S3 bucket, used to match the detections and to filter them by
# MAX_DISTANCE. MASK_KEY is the full resolution, unlike the MASK_INPUT_KEY of 'mask_synapses':
# the matching needs the highest resolution available.
export MASK_PATH=<cochlea>/images/ome-zarr/<ihc_prediction>.ome.zarr
export MASK_KEY="s0"

export VOXEL_SIZE="0.38 0.38 0.38"
export THRESHOLD=0.5

# Keep MAX_DISTANCE equal to the one of 'mask_synapses', which checks the dilation of the mask
# against it. A larger distance here matches detections the mask never covered.
export MAX_DISTANCE=3.0

echo "Output directory: ${OUTPUT_FOLDER}"
echo "Mask: ${MASK_PATH}"

# Verify the input of the job. A missing input stops the rest of the pipeline.
for path in "$OUTPUT_FOLDER"/predictions.zarr ; do
	if [ ! -e "$path" ] ; then
		echo "Missing input of the job: $path"
		exit 1
	fi
done

# '--force_overwrite' recomputes the detection even if a table of an earlier run is in the folder.
# The prediction is always fresh when this step runs in the chain, and a rerun through '--start-at'
# is a deliberate recomputation. Reusing the table would risk serving the peaks of a truncated
# volume.
# VOXEL_SIZE is not quoted, so that it gives three values.
flamingo_tools.run_synapse_detection_slurm --output_folder "$OUTPUT_FOLDER" --voxel_size $VOXEL_SIZE \
	--threshold "$THRESHOLD" --mask_path "$MASK_PATH" --s3_mask --mask_key "$MASK_KEY" \
	--max_distance "$MAX_DISTANCE" --force_overwrite
