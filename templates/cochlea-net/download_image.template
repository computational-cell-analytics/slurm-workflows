#!/bin/bash
#SBATCH --job-name=<job_name>
#SBATCH -t <time>
#SBATCH --mail-user=<user_address>
#SBATCH --mail-type=FAIL

#SBATCH -p standard96s:shared
#SBATCH -A <account_name>
#SBATCH -c 1
#SBATCH --mem <mem>
#SBATCH --constraint=inet

# Print the exit code for the archive, see doc/new_template.md.
trap 'exit 143' TERM
trap 'echo "Exit code of the job: $?"' EXIT

source ~/.bashrc

# Image data of one stain, which 'mobie_transfer_dataset' copied to the S3 bucket. The n5 of the
# initial processing is removed after a cochlea is processed, so the bucket can hold the only copy.
# The stain is the name of the source in the dataset.json. The steps after this one read the
# OME-Zarr from OUTPUT.
S3_REMOTE=<s3_remote>
OUTPUT=<data_dir>/<cochlea>/<stain>.ome.zarr
STAIN=<stain>

# The OME-Zarr has about 300k chunks of about 130 KiB. The latency of each chunk limits the rate,
# not the CPU or the bandwidth, so more parallel transfers give a higher rate. The stats give one
# line per minute with a time stamp.
RCLONE_OPTIONS=(--transfers=16 --checkers=16 --stats=1m --stats-one-line --stats-log-level=NOTICE)

echo "Download of the source $STAIN of $S3_REMOTE/<cochlea> to $OUTPUT on node $(hostname)"

module load rclone

# The transfer lists a source in the dataset.json of the bucket only after its data is complete, so
# a data folder alone can be a partial copy. The OME-Zarr folder of a source can have another name,
# e.g. 'PV_resized.ome.zarr' for the source PV. The rule is `source_image_path()` of slurm_workflows:
# the 's3Address' first, then the 'relativePath'. A failed 'rclone cat' gives no valid JSON. A
# failed check stops the rest of the pipeline.
IMAGE_PATH=$(rclone cat "$S3_REMOTE/<cochlea>/dataset.json" | python3 -c '
import json, sys
entry = json.load(sys.stdin)["sources"].get(sys.argv[1], {})
image_data = next(iter(entry.values()), {}).get("imageData", {})
if "ome.zarr.s3" in image_data:
    print(image_data["ome.zarr.s3"]["s3Address"].split("/" + sys.argv[2] + "/", 1)[-1].rstrip("/"))
elif "ome.zarr" in image_data:
    print(image_data["ome.zarr"]["relativePath"].rstrip("/"))
' "$STAIN" "<cochlea>")
if [ -z "$IMAGE_PATH" ] ; then
	echo "The dataset.json of $S3_REMOTE/<cochlea> lists no image data of a source $STAIN."
	exit 1
fi
INPUT=<cochlea>/$IMAGE_PATH
echo "Image data of the source $STAIN: $S3_REMOTE/$INPUT"

# rclone copies only the files which are missing or differ, so a rerun completes a partial download.
# A new download goes to a temporary folder first, so that an interrupted job leaves no partial
# OUTPUT, which a later deployment would read.
if [ -e "$OUTPUT" ] ; then
	rclone "${RCLONE_OPTIONS[@]}" copyto "$S3_REMOTE/$INPUT" "$OUTPUT" || exit 1
else
	rclone "${RCLONE_OPTIONS[@]}" copyto "$S3_REMOTE/$INPUT" "$OUTPUT.part" || exit 1
	mv -T "$OUTPUT.part" "$OUTPUT" || exit 1
fi
