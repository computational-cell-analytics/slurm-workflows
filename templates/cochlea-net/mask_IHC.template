#!/bin/bash
#SBATCH --job-name=mask-IHC_<cochlea_job_name>
#SBATCH -t <time>
#SBATCH --mail-user=<user_address>
#SBATCH --mail-type=FAIL

#SBATCH -p standard96s:shared
#SBATCH -A <account_name>
#SBATCH -c 4
#SBATCH --mem <mem>

# Print the exit code for the archive, see doc/new_template.md.
trap 'exit 143' TERM
trap 'echo "Exit code of the job: $?"' EXIT

source ~/.bashrc
micromamba activate <cochlea-net_environment>

export INPUT=<data_dir>/<cochlea>/<cochlea_data>
export OUTPUT_FOLDER=<data_dir>/predictions/<cochlea>/<prediction_dir>
export SEG_MASKING=<masking>
export INPUT_KEY=<input_key>
export ABSOLUTE_THRESHOLD=<ihc_masking_threshold>

echo "Input directory: ${INPUT}"
echo "Output directory: ${OUTPUT_FOLDER}"

# Verify the input of the job. A missing input stops the rest of the pipeline.
for path in "$INPUT" ; do
	if [ ! -e "$path" ] ; then
		echo "Missing input of the job: $path"
		exit 1
	fi
done

if [ ! -d "$OUTPUT_FOLDER" ] ; then
	mkdir -p "$OUTPUT_FOLDER"
fi

flamingo_tools.run_unet_prediction_preprocess_slurm --input_path "$INPUT" --input_key "$INPUT_KEY" \
	--output_folder "$OUTPUT_FOLDER" --seg_class "$SEG_MASKING" --absolute_threshold "$ABSOLUTE_THRESHOLD"

