#!/bin/bash
#SBATCH --job-name=mobie_transfer_<cochlea_job_name>
#SBATCH -t <time>
#SBATCH --mail-user=<user_address>
#SBATCH --mail-type=FAIL

#SBATCH -p standard96s:shared
#SBATCH -A <account_name>
#SBATCH -c 1
#SBATCH --mem <mem>
#SBATCH --constraint=inet

# Print the exit code for the archive, see doc/new_template.md.
trap 'exit 143' TERM
trap 'echo "Exit code of the job: $?"' EXIT

source ~/.bashrc
micromamba activate <mobie_environment>

MOBIE_PROJECT=<mobie_project>

INPUT=<mobie_project>/<cochlea>/dataset.json

# One entry per stain. mobie lists a source in dataset.json only after its conversion is complete,
# so a stain without an entry would leave an incomplete dataset in the bucket.
CHANNEL_ARR=(<channel_multi>)

# The settings hold the rclone remote in the form remote:bucket. Only the bucket name is needed here.
S3_REMOTE=<s3_remote>
BUCKET_NAME="${S3_REMOTE#*:}"

echo "Transfer of <cochlea> from ""$MOBIE_PROJECT"" to S3"

for path in "$INPUT" ; do
	if [ ! -e "$path" ] ; then
		echo "Missing input of the job: $path"
		exit 1
	fi
done

for channel in "${CHANNEL_ARR[@]}" ; do
	if ! python -c "import json, sys; sys.exit(sys.argv[2] not in json.load(open(sys.argv[1]))['sources'])" "$INPUT" "$channel" ; then
		echo "Missing input of the job: $channel is no source of $INPUT"
		exit 1
	fi
done

# replace maximal intensity reference 65535 with the more reasonable value 1400
sed -i 's/65535/1400/g' "$INPUT"

mobie.add_remote_metadata -s <service_endpoint> -b "$BUCKET_NAME" -i "$MOBIE_PROJECT" || exit 1

module load rclone
rclone --progress copyto "$MOBIE_PROJECT"/<cochlea>/images/ome-zarr <s3_remote>/<cochlea>/images/ome-zarr || exit 1

# The dataset.json and the project.json of the S3 bucket list the sources and the datasets of every
# local MoBIE project. The local files must not replace them, so only the stains and the name of
# this cochlea are added. dataset.json comes last, so that the bucket lists a source only after its
# data is complete.
python <repo:slurm-workflows>/scripts/add_s3_dataset.py -p "$MOBIE_PROJECT" -r <s3_remote> -d <cochlea> \
	--source "${CHANNEL_ARR[@]}"
