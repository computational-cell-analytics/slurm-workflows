#!/bin/bash
#SBATCH --job-name=mobie_transfer_<cochlea_job_name>
#SBATCH -t 09:00:00             # estimated time, adapt to your needs
#SBATCH --mail-user=<user_address> # change this to your mailaddress
#SBATCH --mail-type=FAIL        # send mail when job begins and ends

#SBATCH -p standard96s:shared         # the partition
#SBATCH -A <account_name>
#SBATCH -c 1
#SBATCH --mem 4G
#SBATCH --constraint=inet

source ~/.bashrc
micromamba activate <mobie_environment>

# Run the script

MOBIE_PROJECT=<mobie_project>

INPUT=<mobie_project>/<cochlea>/dataset.json

# The settings hold the rclone remote in the form remote:bucket. Only the bucket name is needed here.
S3_REMOTE=<s3_remote>
BUCKET_NAME="${S3_REMOTE#*:}"

echo "Transfer of <cochlea> from ""$MOBIE_PROJECT"" to S3"

for path in "$INPUT" ; do
	if [ ! -e "$path" ] ; then
		echo "Missing input of the job: $path"
		exit 1
	fi
done

# replace maximal intensity reference 65535 with the more reasonable value 1400
sed -i 's/65535/1400/g' "$INPUT"

mobie.add_remote_metadata -s <service_endpoint> -b "$BUCKET_NAME" -i "$MOBIE_PROJECT" || exit 1

module load rclone
rclone --progress copyto "$INPUT" <s3_remote>/<cochlea>/dataset.json || exit 1
rclone --progress copyto "$MOBIE_PROJECT"/<cochlea>/images/ome-zarr <s3_remote>/<cochlea>/images/ome-zarr || exit 1

# The project.json of the S3 bucket lists the datasets of every local MoBIE project. The local
# file must not replace it, so only the name of this cochlea is added.
python <slurm-workflows>/scripts/add_s3_dataset.py -p "$MOBIE_PROJECT" -r <s3_remote> -d <cochlea>
