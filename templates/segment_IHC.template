#!/bin/bash
#SBATCH --job-name=segment-unet-IHC_<cochlea_job_name>
#SBATCH -t 04:00:00             # estimated time, adapt to your needs
#SBATCH --mail-user=<user_address> # change this to your mailaddress
#SBATCH --mail-type=FAIL        # send mail when job begins and ends

#SBATCH -p standard96s:shared         # the partition
#SBATCH -A <account_name>
#SBATCH -c 8
#SBATCH --mem 100G

source ~/.bashrc
micromamba activate <cochlea-net_environment>

# Print out some info.
echo "Submitting job with sbatch from directory: ${SLURM_SUBMIT_DIR}"
echo "Home directory: ${HOME}"
echo "Working directory: $PWD"
echo "Current node: ${SLURM_NODELIST}"

# Run the script
#python myprogram.py $SLURM_ARRAY_TASK_ID

SCRIPT_REPO=<cochlea-net>
cd "$SCRIPT_REPO"/flamingo_tools/segmentation/ || exit

export SCRIPT_DIR=$SCRIPT_REPO/scripts
export OUTPUT_FOLDER=<data_dir>/predictions/<cochlea>/<prediction_dir>
export MIN_SIZE=1000

export CENTER_DISTANCE_THRESHOLD=<center_distance_threshold>
export BOUNDARY_DISTANCE_THRESHOLD=<boundary_distance_threshold>
export DISTANCE_SMOOTHING=<distance_smoothing>

echo "Output directory: ${OUTPUT_FOLDER}"
echo "CENTER_DISTANCE_THRESHOLD: ${CENTER_DISTANCE_THRESHOLD}"
echo "BOUNDARY_DISTANCE_THRESHOLD: ${BOUNDARY_DISTANCE_THRESHOLD}"
echo "DISTANCE_SMOOTHING: ${DISTANCE_SMOOTHING}"

# Verify the input of the job. A missing input stops the rest of the pipeline.
for path in "$OUTPUT_FOLDER"/predictions.zarr ; do
	if [ ! -e "$path" ] ; then
		echo "Missing input of the job: $path"
		exit 1
	fi
done

cmd_array=(	'import sys,os;'
	'sys.path.insert(0,os.environ["SCRIPT_DIR"]);'
	'import unet_prediction;'
	'unet_prediction.run_unet_segmentation_slurm(output_folder=os.environ["OUTPUT_FOLDER"],'
	'center_distance_threshold=os.environ["CENTER_DISTANCE_THRESHOLD"],'
	'boundary_distance_threshold=os.environ["BOUNDARY_DISTANCE_THRESHOLD"],'
	'distance_smoothing=os.environ["DISTANCE_SMOOTHING"],'
	'min_size=os.environ["MIN_SIZE"])')
cmd="${cmd_array[*]}"
python -c "$cmd"

